# Only the Econtent development project. Never a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Credit billing remains closed unless both server and public flags use this
# exact reviewed activation value. Never expose the service-role key publicly.
ECONTENT_EXPORT_BILLING_ENABLED=disabled
NEXT_PUBLIC_EXPORT_BILLING_ENABLED=disabled
ECONTENT_PAYMENT_COLLECTION_ENABLED=disabled # use flutterwave-test in Preview only
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave Test Mode only. These are server secrets except NEXT_PUBLIC_*.
FLUTTERWAVE_MODE=test
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
ECONTENT_APP_URL=http://localhost:3000
NEXT_PUBLIC_FLUTTERWAVE_TEST_ENABLED=false
